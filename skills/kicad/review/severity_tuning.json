{
  "version": "1.0",
  "rules": {
    "AM-001": {
      "base_severity": "error",
      "tuning_max_severity": "error",
      "tuning": [
        {"when": {"environment": "hobby"}, "severity_floor": "warning"}
      ]
    },
    "OV-001": {
      "base_severity": "warning",
      "tuning_max_severity": "error",
      "tuning": [
        {"when": {"environment": "automotive"}, "severity_delta": "+1"},
        {"when": {"environment": "medical"}, "severity_delta": "+1"}
      ]
    },
    "TJ-001": {"base_severity": "error", "tuning_max_severity": "error", "tuning": []},
    "FT-001": {"base_severity": "error", "tuning_max_severity": "error", "tuning": []},
    "PM-001": {"base_severity": "warning", "tuning_max_severity": "error", "tuning": []},
    "EX-001": {"base_severity": "error", "tuning_max_severity": "error", "tuning": []},
    "PU-001": {"base_severity": "warning", "tuning_max_severity": "error", "tuning": []},
    "LR-001": {"base_severity": "info", "tuning_max_severity": "warning", "tuning": []},
    "XT-001": {"base_severity": "warning", "tuning_max_severity": "error", "tuning": []},
    "FS-001": {"base_severity": "error", "tuning_max_severity": "error", "tuning": []},
    "VM-001": {
      "base_severity": "error",
      "tuning_max_severity": "error",
      "tuning": [
        {"when": {"environment": "hobby"}, "severity_floor": "warning"}
      ]
    }
  }
}
